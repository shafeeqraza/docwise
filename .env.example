APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker host ports (compose.yaml)
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Default: PostgreSQL + pgvector (container "vector-postgres").
# In Docker, DB_HOST is overridden to host.docker.internal.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=6543
DB_DATABASE=docwise
DB_USERNAME=postgres
DB_PASSWORD=

# Docker only (compose.yaml). The compose DB containers are created from
# DB_USERNAME / DB_PASSWORD / DB_DATABASE on first start (empty volume).
# MYSQL_ROOT_PASSWORD defaults to DB_PASSWORD.
# MYSQL_ROOT_PASSWORD=
# Inside Docker the app uses these instead of DB_HOST / DB_PORT:
# DOCKER_DB_HOST=docwise-postgres   # or docwise-mysql
# DOCKER_DB_PORT=5432               # or 3306
# Host ports for the compose DB containers:
# DOCKER_PG_PORT=5433
# DOCKER_MYSQL_PORT=3308
# DOCKER_QDRANT_PORT=6335

# Alternative: MySQL (container "mysql-container") + Qdrant (container "qdrant-container").
# Also set VECTOR_STORE_DRIVER=qdrant below.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_DATABASE=docwise
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Vector store: "pgsql" (pgvector, requires DB_CONNECTION=pgsql) or "qdrant"
VECTOR_STORE_DRIVER=pgsql
VECTOR_DIMENSION=1536

# Qdrant (container "qdrant-container"). In Docker, QDRANT_HOST is overridden to http://host.docker.internal.
QDRANT_HOST=http://localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT=30

# LLM / embedding providers
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_TIMEOUT=60

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=60

# Chat defaults
CHAT_DEFAULT_LLM_MODEL="Gemini 2.5 Flash"
CHAT_DEFAULT_EMBEDDING_MODEL=models/gemini-embedding-001
CHAT_MAX_CONTEXT_CHUNKS=5
CHAT_MAX_HISTORY=10
CHAT_TEMPERATURE=0.7
CHAT_MAX_TOKENS=1000
CHAT_MAX_INPUT_CHARS=8000
CHAT_MAX_INPUT_TOKENS=2000
CHAT_MAX_OUTPUT_TOKENS=1000
CHAT_MAX_TOTAL_TOKENS=8000

# Document storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true
CLOUDINARY_UPLOAD_FOLDER=docwise/documents

# pdftotext binary (poppler). In Docker this is overridden to /usr/bin/pdftotext.
PDF_TO_TEXT_PATH=
